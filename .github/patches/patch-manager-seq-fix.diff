+  /// 用补丁文件头预检这份补丁对本机是否有效，有效返回 null
+  ///
+  /// 原生只拿前 146 字节判断：宿主指纹不符、序号没有超过本机已接受的水位
+  /// 都会被判为"不新鲜"。这两种情况装上去也不会成功，提前拦下能把
+  /// invalidArgs 还原成具体原因，并省掉一次整包安装。
+  static Future<String?> _precheck(List<int> bytes) async
+  {
+    try
+    {
+      final int head = bytes.length < _patchHeaderSize
+          ? bytes.length
+          : _patchHeaderSize;
+      final PatchInspection inspection =
+          await FlutterPatcher.inspectPatch(bytes.sublist(0, head));
+      if (inspection.fresh)
+      {
+        return null;
+      }
+
+      final String reason = inspection.reason ?? '未知原因';
+      if (reason.contains('another host'))
+      {
+        return '这份补丁不属于当前宿主，需要按本机宿主重新出补丁';
+      }
+      if (reason.contains('newer'))
+      {
+        final int acceptedSeq = await _acceptedSeq();
+        return '补丁序号 ${inspection.seq ?? 0} 没有超过本机已接受的 '
+            '$acceptedSeq，需要重新出序号更大的补丁';
+      }
+      return '补丁文件头无效：$reason';
+    }
+    catch (e)
+    {
+      // 预检失败不阻断安装，交给原生做完整的验签与长度校验
+      debugPrint('[PatchManager] precheck failed: $e');
+      return null;
     }
   }
 
